@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.


@using MathLibrary

<h3>DLL Test</h3>

<p>2 + 3 = @result</p>

@code {
    int result;

    protected override void OnInitialized()
    {
        var calc = new Calculator();
        result = calc.Add(2, 3);
    }
}